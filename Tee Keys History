<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TEE KEYS DESIGN COMPANY</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        header {
            background: #111;
            color: white;
            text-align: center;
            padding: 30px 15px;
        }

        header h1 {
            margin: 0;
            font-size: 32px;
        }

        header p {
            margin-top: 10px;
        }

        nav {
            background: #222;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 12px;
            font-weight: bold;
        }

        nav a:hover {
            color: #ffd700;
        }

        .hero {
            background: white;
            text-align: center;
            padding: 70px 20px;
        }

        .hero h2 {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            color: #555;
        }

        .button {
            display: inline-block;
            margin-top: 20px;
            padding: 14px 25px;
            background: #111;
            color: white;
            text-decoration: none;
            border-radius: 6px;
        }

        .button:hover {
            background: #444;
        }

        .section {
            padding: 50px 20px;
            text-align: center;
        }

        .section h2 {
            font-size: 30px;
            margin-bottom: 30px;
        }

        .products {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .product {
            background: white;
            width: 280px;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .product img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 6px;
            background: #ddd;
        }

        .product h3 {
            margin-bottom: 10px;
        }

        .price {
            font-size: 20px;
            font-weight: bold;
            color: #111;
        }

        .order-button {
            background: #111;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 10px;
        }

        .order-button:hover {
            background: #444;
        }

        .about {
            background: white;
        }

        .contact {
            background: #eee;
        }

        footer {
            background: #111;
            color: white;
            text-align: center;
            padding: 25px;
        }

        @media (max-width: 600px) {
            .hero h2 {
                font-size: 30px;
            }

            nav a {
                display: inline-block;
                margin: 6px;
            }

            .product {
                width: 100%;
                max-width: 320px;
            }
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <header>
        <h1>TEE KEYS DESIGN COMPANY</h1>
        <p>Quality Products. Great Service.</p>
    </header>

    <!-- NAVIGATION -->
    <nav>
        <a href="#">Home</a>
        <a href="#products">Products</a>
        <a href="#about">About Us</a>
        <a href="#contact">Contact</a>
    </nav>

    <!-- HERO -->
    <section class="hero">
        <h2>Welcome to TEE KEYS DESIGN COMPANY</h2>

        <p>
            Discover our products and shop with us.
        </p>

        <a href="#products" class="button">
            Shop Now
        </a>
    </section>

    <!-- PRODUCTS -->
    <section class="section" id="products">

        <h2>Our Products</h2>

        <div class="products">

            <div class="product">

                <img
                    src="https://via.placeholder.com/280x200"
                    alt="Product One"
                >

                <h3>Product One</h3>

                <p>
                    Quality product from Tee Keys Design Company.
                </p>

                <p class="price">
                    ₦25,000
                </p>

                <button
                    class="order-button"
                    onclick="orderProduct('Product One', 25000)"
                >
                    Order Now
                </button>

            </div>


            <div class="product">

                <img
                    src="https://via.placeholder.com/280x200"
                    alt="Product Two"
                >

                <h3>Product Two</h3>

                <p>
                    Quality product from Tee Keys Design Company.
                </p>

                <p class="price">
                    ₦35,000
                </p>

                <button
                    class="order-button"
                    onclick="orderProduct('Product Two', 35000)"
                >
                    Order Now
                </button>

            </div>


            <div class="product">

                <img
                    src="https://via.placeholder.com/280x200"
                    alt="Product Three"
                >

                <h3>Product Three</h3>

                <p>
                    Quality product from Tee Keys Design Company.
                </p>

                <p class="price">
                    ₦45,000
                </p>

                <button
                    class="order-button"
                    onclick="orderProduct('Product Three', 45000)"
                >
                    Order Now
                </button>

            </div>

        </div>

    </section>


    <!-- ABOUT -->
    <section class="section about" id="about">

        <h2>About Us</h2>

        <p>
            Welcome to TEE KEYS DESIGN COMPANY.
        </p>

        <p>
            We are committed to providing quality products
            and excellent service to our customers.
        </p>

    </section>


    <!-- CONTACT -->
    <section class="section contact" id="contact">

        <h2>Contact Us</h2>

        <p>Email: your-email@example.com</p>

        <p>Phone: +234 XXX XXX XXXX</p>

    </section>


    <!-- FOOTER -->
    <footer>

        <p>
            © 2026 TEE KEYS DESIGN COMPANY
        </p>

        <p>
            All rights reserved.
        </p>

    </footer>


    <!-- JAVASCRIPT -->
    <script>

        function orderProduct(productName, price) {

            alert(
                "You selected " +
                productName +
                " - ₦" +
                price.toLocaleString() +
                ".\n\n" +
                "The online ordering system will be added next."
            );

        }

    </script>

</body>
</html>
